{{#if equipmentTray.meleeWeapon}}
  <img
    class='{{equipmentTray.meleeWeapon.rarity}}-item action-hover quick-slot-1 {{#if (eq equipmentTray.activeSlot 1)}}multi-additional{{/if}}'
    data-item-id='{{equipmentTray.meleeWeapon.id}}'
    data-drag='true'
    data-action='useItem'
    data-index='meleeWeapon'
    data-action-type='{{equipmentTray.meleeWeapon.actionType}}'
    data-action-range='{{equipmentTray.meleeWeapon.actionRange}}'
    src='{{equipmentTray.meleeWeapon.img}}'
    alt='{{equipmentTray.meleeWeapon.name}}'
    {{#with equipmentTray.meleeWeapon}}
      data-tooltip="{{this.name}}" data-tooltip-key="{{lazyTooltip this}}"
    {{/with}}
    data-tooltip-direction='UP'
  />
{{else}}
  <div class='transparent-box' data-drag='true' data-index='meleeWeapon'></div>
{{/if}}

{{#if equipmentTray.rangedWeapon}}
  <img
    class='{{equipmentTray.rangedWeapon.rarity}}-item action-hover quick-slot-2 {{#if (eq equipmentTray.activeSlot 2)}}multi-additional{{/if}}'
    data-drag='true'
    data-item-id='{{equipmentTray.rangedWeapon.id}}'
    data-action='useItem'
    data-index='rangedWeapon'
    data-action-type='{{equipmentTray.rangedWeapon.actionType}}'
    data-action-range='{{equipmentTray.rangedWeapon.actionRange}}'
    src='{{equipmentTray.rangedWeapon.img}}'
    alt='{{equipmentTray.rangedWeapon.name}}'
    {{#with equipmentTray.rangedWeapon}}
      data-tooltip="{{this.name}}" data-tooltip-key="{{lazyTooltip this}}"
    {{/with}}
    data-tooltip-direction='UP'
  />
{{else}}
  <div class='transparent-box' data-drag='true' data-index='rangedWeapon'></div>
{{/if}}
